rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // FASE INTERMEDIA (desarrollo): se exige login para escribir y para la
    // información interna. Solo la lectura pública de planillas queda abierta.
    // Al cierre del proyecto: reglas finas por rol (admin confirma, empleado
    // solo su agencia, público solo lectura de planillas).
    function autenticado() {
      return request.auth != null;
    }

    match /usuarios/{uid} {
      allow read, write: if autenticado();
    }

    match /agencias/{agenciaId} {
      allow read: if true;
      allow write: if autenticado();
    }

    match /clientes/{clienteId} {
      allow read: if true;
      allow write: if autenticado();
    }

    match /movimientos_pendientes/{id} {
      allow read, write: if autenticado();
    }

    match /movimientos_confirmados/{id} {
      allow read: if true;
      allow write: if autenticado();
    }

    match /tirillas/{id} {
      allow read, write: if autenticado();
    }
  }
}